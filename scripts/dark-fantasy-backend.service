[Unit]
Description=Dark Fantasy Hack & Slash Backend API Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/dark-fantasy-backend
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
Environment=PORT=3001
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
